# DEVELOPMENT ONLY. Copy to .env and replace secrets before any shared deployment.
APP_ENV=development
APP_NAME="Saathi Student Wellness"
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
SECRET_KEY=replace-this-development-secret-with-at-least-32-random-characters
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Native Windows PostgreSQL connection. Docker Compose overrides DATABASE_URL to use its db service.
POSTGRES_ADMIN_PASSWORD=local-admin-change-me
WELLNESS_DB_PASSWORD=local-app-change-me
DATABASE_URL=postgresql+psycopg://wellness_app:local-app-change-me@localhost:5432/wellness
SEED_DEMO_DATA=true

# OpenAI-compatible chat endpoint. Empty means safe synthetic-demo responses only.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Embedding provider is separate from Pinecone. Must return exactly PINECONE_DIMENSION values.
# Empty means deterministic demo-only hashing vectors; never use those for a live service.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Pinecone stores only reviewed/approved knowledge vectors, never journal entries or transcripts.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=saathi-knowledge
PINECONE_CLOUD=aws
# Pinecone's current public serverless region list does not include India.
# Starter supports us-east-1; ap-southeast-1 (Singapore) requires a plan that supports that region.
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=384
# Keep false until a privacy/legal review approves sending student-derived query vectors to Pinecone.
PINECONE_QUERY_VECTORS_ENABLED=false
PINECONE_CROSS_BORDER_APPROVED=false

# Voice transcription: OpenAI-compatible POST /audio/transcriptions. No raw audio is retained by the app.
STT_API_BASE_URL=
STT_API_KEY=
STT_MODEL=
VOICE_ENABLED=true

# n8n Cloud instance: https://abhijitdutta-pm-new.app.n8n.cloud/
# Endpoints are prefilled for your instance; keep N8N_ENABLED=false until imported workflows,
# Header Auth, SMTP, and synthetic tests are complete. Then copy each exact Production URL from n8n.
N8N_ENABLED=false
N8N_WEBHOOK_URL=https://abhijitdutta-pm-new.app.n8n.cloud/webhook/wellness-events
N8N_REPORT_WEBHOOK_URL=https://abhijitdutta-pm-new.app.n8n.cloud/webhook/wellness-daily-report
N8N_HEALTH_WEBHOOK_URL=https://abhijitdutta-pm-new.app.n8n.cloud/webhook/wellness-health-check
N8N_WEBHOOK_SECRET=change-this-n8n-webhook-secret
N8N_DISPATCH_INTERVAL_SECONDS=10
INTERNAL_API_SECRET=change-this-internal-api-secret
